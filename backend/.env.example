# ==============================================================================
# PROJECT PARTNER BACKEND — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Use standard Google AI Studio API instead of Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=False


# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD & FIRESTORE CONFIGURATION (OPTIONAL / LOCAL DEV)
# ------------------------------------------------------------------------------
# Set your Google Cloud Project ID (e.g. collaborative-partner-dev)
GOOGLE_CLOUD_PROJECT=project-partner-demo

# If using the local Firestore Emulator, uncomment the line below:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Path to service account key file (if connecting to real Cloud Firestore without gcloud login):
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json


# ------------------------------------------------------------------------------
# 3. FASTAPI SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=True
